{
  "expo": {
    "name": "Abstracts Mobile",
    "slug": "abstracts-mobile",
    "scheme": "abstractsmobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.abstracts.researchhub",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "This app requires access to your photo library so you can set your profile picture."
      }
    },
    "icon": "./logo/icon.png",
    "android": {
      "package": "com.abstracts.researchhub",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./logo/icon.png",
        "backgroundColor": "#090B10"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "This app requires access to your photo library so you can set your profile picture."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c81e5673-8629-4bd7-a671-2591d968d212"
      }
    }
  }
}