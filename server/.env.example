# Database Configuration
MONGO_URI=mongodb+srv://<username>:<password>@cluster.example.mongodb.net/researchhub?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
PORT=3001
NODE_ENV=development
ADMIN_SECRET_KEY=your_admin_secret_key_here

# AI & External APIs
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here

# Firebase Client API Key (Fallback verification)
FIREBASE_API_KEY=your_firebase_web_api_key_here

# Firebase Admin SDK Credentials
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# SMTP Email Configuration
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your_smtp_password_or_api_key
SMTP_SECURE=false
